<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Fusion - Skill-Based Betting</title>

  <style>

    body {

      font-family: Arial, sans-serif;

      background-color: #0f0f0f;

      color: white;

      text-align: center;

      margin: 0;

      padding: 0;

    }

    header {

      background-color: #ff3b3b;

      padding: 15px;

      font-size: 32px;

      font-weight: bold;

    }

    .button {

      background-color: #ff3b3b;

      color: white;

      border: none;

      padding: 10px 20px;

      border-radius: 6px;

      cursor: pointer;

      margin: 10px;

    }

    .section {

      margin: 30px 0;

      padding: 20px;

    }

    .card {

      background-color: #1a1a1a;

      border: 1px solid #333;

      border-radius: 8px;

      padding: 15px;

      margin: 10px auto;

      width: 80%;

      max-width: 400px;

    }

    .cta {

      background-color: #ff3b3b;

      color: white;

      font-size: 18px;

      padding: 15px 30px;

      border: none;

      border-radius: 8px;

      cursor: pointer;

      margin-top: 20px;

    }

  </style>

</head>

<body>



  <header>Fusion</header>



  <div>

    <button class="button">Login</button>

    <button class="button">Sign Up</button>

  </div>



  <div class="section" id="matchesSection">

    <h2>Live Matches</h2>

    <!-- Matches will be added here by JavaScript -->

  </div>



  <div class="section" id="topPlayersSection">

    <h2>Top Players</h2>

    <!-- Players will be added here by JavaScript -->

  </div>



  <button class="cta">Watch & Bet Live!</button>



  <script>

    // Example match data

    const matches = [

      { game: "Madden 1v1", pot: 20 },

      { game: "Fortnite 1v1", pot: 50 },

      { game: "NBA 2K 1v1", pot: 10 },

    ];



    // Example top players

    const topPlayers = [

      { name: "@GamerKing", winnings: 5000 },

      { name: "@FusionQueen", winnings: 3200 },

    ];



    // Display matches

    const matchesSection = document.getElementById("matchesSection");

    matches.forEach((match) => {

      const div = document.createElement("div");

      div.className = "card";

      div.innerHTML = `

        <strong>${match.game}</strong> - $${match.pot} Pot

        <br><br>

        <button class="button" onclick="alert('Watching ${match.game}')">Watch</button>

        <button class="button" onclick="alert('Joining ${match.game}')">Join</button>

      `;

      matchesSection.appendChild(div);

    });



    // Display top players

    const topPlayersSection = document.getElementById("topPlayersSection");

    topPlayers.forEach((player) => {

      const div = document.createElement("div");

      div.className = "card";

      div.innerHTML = `

        <strong>${player.name}</strong><br>

        $${player.winnings.toLocaleString()} Won

      `;

      topPlayersSection.appendChild(div);

    });

  </script>



</body>

</html>
